{
  "manifest_version": 3,
  "name": "OmniRoute Session Sync",
  "version": "2.0.0",
  "description": "Pair Chrome with a local bridge to sync mapped browser sessions and manage an OmniRoute fallback.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "background"
  ],
  "host_permissions": [
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*",
    "https://*.google.com/*",
    "https://*.z.ai/*",
    "https://*.qwen.ai/*",
    "https://*.deepseek.com/*",
    "https://*.grok.com/*",
    "http://127.0.0.1:20129/*",
    "http://localhost:20129/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OmniRoute Session Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
